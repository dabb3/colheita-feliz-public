<Match>
<Class name="br.com.colheitafeliz.domain.economy.Market"/>
<Bug pattern="EI_EXPOSE_REP2"/>
</Match>
<Match>
<Class name="br.com.colheitafeliz.game.GameSession"/>
<Bug pattern="EI_EXPOSE_REP"/>
</Match>
<!-- Baseline: EI_EXPOSE_REP em GameState (retorna referências internas) -->
<Match>
<Class name="br.com.colheitafeliz.game.GameState"/>
<Bug pattern="EI_EXPOSE_REP"/>
</Match>
<!-- Baseline: EI_EXPOSE_REP em FarmRenderer -->
<Match>
<Class name="br.com.colheitafeliz.render.FarmRenderer"/>
<Bug pattern="EI_EXPOSE_REP"/>
</Match>
