  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "review/**/*.ts"]
}
