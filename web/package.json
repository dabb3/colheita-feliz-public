{
  "name": "colheita-feliz-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:local": "npm run typecheck && node scripts/build.mjs --local",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test --project=chromium-desktop --project=webkit-desktop --project=webkit-iphone",
    "test:e2e:chromium": "playwright test --project=chromium-desktop",
    "test:e2e:webkit": "playwright test --project=webkit-desktop",
    "test:e2e:iphone": "playwright test --project=webkit-iphone",
    "test:safari:simulator": "node e2e/safari-simulator.mjs",
    "review": "node scripts/review.mjs",
    "test:browser": "playwright test e2e/farm.spec.ts --project=chromium-desktop"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
